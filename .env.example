# --- banco e fila ---
# Entre aspas: a URL do Neon tem & e quebra quando o shell lê o arquivo.
DATABASE_URL="postgres://filaviva:filaviva@localhost:5432/filaviva"
REDIS_URL=redis://localhost:6379

# --- auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-32-caracteres-aleatorios-aqui
BETTER_AUTH_URL=http://localhost:3000

# --- api e web ---
API_PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000
WEBHOOK_TOKEN=troque-este-token-de-webhook

# --- canais: mock funciona sem chave nenhuma ---
CANAL_WHATSAPP=mock   # mock | kapso
CANAL_SMS=mock        # mock | contele
CANAL_EMAIL=mock      # mock | resend

# WhatsApp: proxy Meta da Kapso. O template só é exigido fora da janela de 24h.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE_CONVOCACAO=
KAPSO_TEMPLATE_IDIOMA=pt_BR
# Segredo com que a Kapso assina o corpo do webhook
KAPSO_WEBHOOK_SECRET=

# SMS: Comtele. A API nova usa x-api-key e exige a rota da conta no corpo.
# Conferir com: curl -H "x-api-key: $CONTELE_API_KEY" https://api.comtele.com.br/routes
CONTELE_API_KEY=
CONTELE_ROUTE_ID=17
CONTELE_API_VERSAO=nova   # nova | v2

# E-mail
RESEND_API_KEY=
EMAIL_FROM=fila-viva@example.org

# --- Claude: sem credencial cai para regra por palavra-chave ---
AI_PROVIDER=fallback  # fallback | anthropic | bedrock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Só para chave vinculada a identidade, que exige o workspace no cabeçalho
ANTHROPIC_WORKSPACE_ID=
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# --- seed ---
DADOSCRECHE_DIR=./.dados/dadoscreche
SEED_ANO=2025
SEED_TELEFONES=5521999990001,5521999990002,5521999990003
